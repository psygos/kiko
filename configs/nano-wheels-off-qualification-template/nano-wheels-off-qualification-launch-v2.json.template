{
  "schema_version": 2,
  "robot_id": "${ROBOT_ID}",
  "qualification_executable_asset": {
    "relative_path": "bin/kiko-nano-wheels-off-qualification",
    "maximum_bytes": ${QUALIFICATION_EXECUTABLE_MAXIMUM_BYTES},
    "sha256_hex": "${QUALIFICATION_EXECUTABLE_SHA256}"
  },
  "native_runtime_manifest_asset": {
    "relative_path": "native-runtime-v1.json",
    "maximum_bytes": ${NATIVE_RUNTIME_MANIFEST_MAXIMUM_BYTES},
    "sha256_hex": "${NATIVE_RUNTIME_MANIFEST_SHA256}"
  },
  "agent_policy_asset": {
    "relative_path": "agent-policy-v3.json",
    "maximum_bytes": ${AGENT_POLICY_MAXIMUM_BYTES},
    "sha256_hex": "${AGENT_POLICY_SHA256}"
  },
  "navigation_shadow_config_asset": {
    "relative_path": "navigation-shadow-v1.json",
    "maximum_bytes": ${NAVIGATION_SHADOW_MAXIMUM_BYTES},
    "sha256_hex": "${NAVIGATION_SHADOW_SHA256}"
  },
  "candidate_inventory_manifest_asset": {
    "relative_path": "device-inventory-candidate-v2.json",
    "maximum_bytes": ${CANDIDATE_INVENTORY_MAXIMUM_BYTES},
    "sha256_hex": "${CANDIDATE_INVENTORY_SHA256}"
  },
  "candidate_controller_policy_asset": {
    "relative_path": "candidate-controller-policy-v1.json",
    "maximum_bytes": ${CANDIDATE_CONTROLLER_POLICY_MAXIMUM_BYTES},
    "sha256_hex": "${CANDIDATE_CONTROLLER_POLICY_SHA256}"
  },
  "controller_server": {
    "contract_asset": {
      "relative_path": "controller-server-candidate-v2.json",
      "maximum_bytes": ${CONTROLLER_SERVER_MAXIMUM_BYTES},
      "sha256_hex": "${CONTROLLER_SERVER_SHA256}"
    },
    "command_udp_endpoint": "127.0.0.1:8080"
  },
  "calibration_artifact": {
    "artifact_id": "${CALIBRATION_ARTIFACT_ID}",
    "asset": {
      "relative_path": "artifacts/${CALIBRATION_ARTIFACT_RELATIVE_PATH}",
      "maximum_bytes": ${CALIBRATION_ARTIFACT_MAXIMUM_BYTES},
      "sha256_hex": "${CALIBRATION_ARTIFACT_SHA256}"
    }
  },
  "plant_artifact": {
    "artifact_id": "${SHADOW_PLANT_ARTIFACT_ID}",
    "asset": {
      "relative_path": "artifacts/${SHADOW_PLANT_ARTIFACT_RELATIVE_PATH}",
      "maximum_bytes": ${SHADOW_PLANT_MAXIMUM_BYTES},
      "sha256_hex": "${SHADOW_PLANT_SHA256}"
    }
  },
  "oak": {
    "selector_source": "exact_inventory_oak_mxid",
    "maximum_usb_speed": "SUPER",
    "minimum_usb_speed": "SUPER",
    "rgb": {
      "width_px": ${OAK_RGB_WIDTH_PX},
      "height_px": ${OAK_RGB_HEIGHT_PX},
      "fps": ${OAK_RGB_FPS}
    },
    "rectified_stereo": {
      "width_px": ${OAK_STEREO_WIDTH_PX},
      "height_px": ${OAK_STEREO_HEIGHT_PX},
      "fps": ${OAK_STEREO_FPS},
      "rectified": true
    },
    "depth": {
      "width_px": ${OAK_STEREO_WIDTH_PX},
      "height_px": ${OAK_STEREO_HEIGHT_PX},
      "fps": ${OAK_STEREO_FPS},
      "alignment": "rectified_left"
    },
    "imu": {
      "rate_hz": ${OAK_IMU_RATE_HZ}
    },
    "queue": {
      "size": ${OAK_QUEUE_SIZE},
      "blocking": false
    }
  },
  "occupancy": {
    "resolution_m": ${OCCUPANCY_RESOLUTION_M},
    "lower_x_m": ${OCCUPANCY_LOWER_X_M},
    "lower_y_m": ${OCCUPANCY_LOWER_Y_M},
    "width_cells": ${OCCUPANCY_WIDTH_CELLS},
    "height_cells": ${OCCUPANCY_HEIGHT_CELLS},
    "maximum_cells": ${OCCUPANCY_MAXIMUM_CELLS},
    "maximum_keyframes": ${OCCUPANCY_MAXIMUM_KEYFRAMES},
    "snapshot_every_keyframes": ${OCCUPANCY_SNAPSHOT_EVERY_KEYFRAMES}
  },
  "inference": {
    "onnx_runtime_library_asset": {
      "relative_path": "${ONNX_RUNTIME_LIBRARY_RELATIVE_PATH}",
      "maximum_bytes": ${ONNX_RUNTIME_LIBRARY_MAXIMUM_BYTES},
      "sha256_hex": "${ONNX_RUNTIME_LIBRARY_SHA256}"
    },
    "superpoint_model_asset": {
      "relative_path": "${SUPERPOINT_MODEL_RELATIVE_PATH}",
      "maximum_bytes": ${SUPERPOINT_MODEL_MAXIMUM_BYTES},
      "sha256_hex": "${SUPERPOINT_MODEL_SHA256}"
    },
    "lightglue_model_asset": {
      "relative_path": "${LIGHTGLUE_MODEL_RELATIVE_PATH}",
      "maximum_bytes": ${LIGHTGLUE_MODEL_MAXIMUM_BYTES},
      "sha256_hex": "${LIGHTGLUE_MODEL_SHA256}"
    },
    "superpoint_backend": "${SUPERPOINT_BACKEND}",
    "lightglue_backend": "${LIGHTGLUE_BACKEND}",
    "downscale_factor": ${INFERENCE_DOWNSCALE_FACTOR},
    "maximum_keypoints": ${INFERENCE_MAXIMUM_KEYPOINTS}
  },
  "rerun": {
    "kind": "serve_loopback",
    "bind": "127.0.0.1:9876",
    "decimation": ${RERUN_DECIMATION},
    "memory_limit_bytes": ${RERUN_MEMORY_LIMIT_BYTES},
    "flush_timeout_ms": ${RERUN_FLUSH_TIMEOUT_MS}
  },
  "storage": {
    "map_snapshot_relative_path": "maps/current.kmap",
    "navigation_dataset_directory_relative_path": "navigation",
    "maximum_map_snapshot_bytes": ${MAXIMUM_MAP_SNAPSHOT_BYTES},
    "minimum_free_bytes_after_map_save": ${MINIMUM_FREE_BYTES_AFTER_MAP_SAVE},
    "maximum_navigation_dataset_bytes": ${MAXIMUM_NAVIGATION_DATASET_BYTES},
    "maximum_navigation_dataset_files": ${MAXIMUM_NAVIGATION_DATASET_FILES},
    "maximum_navigation_ingress_records": ${MAXIMUM_NAVIGATION_INGRESS_RECORDS},
    "minimum_free_bytes_after_navigation_dataset_write": ${MINIMUM_FREE_BYTES_AFTER_NAVIGATION_DATASET_WRITE},
    "navigation_dataset_terminal_reserve_bytes": ${NAVIGATION_DATASET_TERMINAL_RESERVE_BYTES}
  }
}
