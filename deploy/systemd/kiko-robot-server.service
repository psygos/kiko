[Unit]
Description=Kiko typed STM32 serial owner
After=local-fs.target
StartLimitIntervalSec=30
StartLimitBurst=3
ConditionPathIsExecutable=/opt/kiko/bin/robot-server
ConditionPathIsRegular=/opt/kiko/deployment/controller-server-v1.json

[Service]
Type=exec
User=makerspace
SupplementaryGroups=dialout
WorkingDirectory=/opt/kiko
Environment=RUST_LOG=info
ExecStart=/opt/kiko/bin/robot-server --command-bind 127.0.0.1:8080 --controller-config /opt/kiko/deployment/controller-server-v1.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
