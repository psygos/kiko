[Unit]
Description=Kiko production Nano agent (manual qualification gate)
Documentation=file:/opt/kiko/deployment/README.md
After=local-fs.target
RequiresMountsFor=/opt/kiko/deployment /var/lib/kiko-nano-agent

[Service]
Type=exec
User=makerspace
SupplementaryGroups=dialout video render plugdev
WorkingDirectory=/opt/kiko
Environment=RUST_LOG=info
# This invariant gate belongs to the base unit, not to an optional drop-in.
# Once systemctl enable creates a persistent wants symlink, deleting a drop-in
# must never leave an ungated boot path.
ExecStartPre=+/opt/kiko/bin/kiko-nano-deployment-gate verify --marker /etc/kiko/nano-agent-offline-install-qualified-v1.json
# Keep the native search path on the production executable only. Applying it
# service-wide would load unverified deployment libraries into ExecStartPre
# before the root-owned gate could verify their exact bytes.
ExecStart=/usr/bin/env LD_LIBRARY_PATH=/opt/kiko/deployment/lib /opt/kiko/bin/kiko-slam nano-agent --deployment-root /opt/kiko/deployment --launch-config nano-agent-launch-v3.json --state-root /var/lib/kiko-nano-agent
Restart=no
# Operational kill guard, not a proven graceful-shutdown bound. Parsed maxima
# bound Rerun/controller/accessory attempts, but worker joins, dataset fsync and
# finalization, OAK close, and native/OS I/O have no outer application deadline.
# Timeout escalation therefore makes physical stop and durable state uncertain.
TimeoutStopSec=420
KillSignal=SIGTERM
KillMode=mixed
# The socket and per-boot console capability share this process-private parent.
# The host boundary rejects a group-readable parent instead of weakening its
# ownership assumptions.
RuntimeDirectory=kiko
RuntimeDirectoryMode=0700
StateDirectory=kiko-nano-agent
StateDirectoryMode=0750
UMask=0077

# The agent must see the real USB/serial devices, but receives no capabilities.
# Device admission remains the application's exact by-id/MXID responsibility.
PrivateDevices=false
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=

# Root-owned code/config stay read-only. Only systemd-managed runtime and state
# directories are writable and persistent state is not removed on service stop.
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/kiko/bin /opt/kiko/deployment
ReadWritePaths=/run/kiko /var/lib/kiko-nano-agent
PrivateTmp=true
RemoveIPC=true
KeyringMode=private

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost
TasksMax=256
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

# Deliberately no [Install] section. Qualification must start this unit
# explicitly; packaging must not enable it automatically.
